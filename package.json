    "@angular/material": "^21.0.0",
    "@angular/platform-browser": "^21.2.13",
    "@angular/router": "^21.2.13",
    "ngx-toastr": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.13",
